* { font-family: "Segoe UI"; color: #0c1930; font-size: 14px; }
QMainWindow, QStackedWidget { background: #f4f7fa; }
QLabel { background: transparent; }
#header { background: #ffffff; border-bottom: 1px solid #e4e9ef; }
#headerDivider { color: #b9c4d0; margin: 10px 10px; }
#appTitle { font-size: 26px; font-weight: 700; }
#appSubtitle, #pageSubtitle, #actionDescription, #muted { color: #617491; }
#appSubtitle { font-size: 16px; }
#hamburgerButton {
    background: #ffffff;
    border: 1px solid #d8e0e8;
    border-radius: 10px;
    color: #15243a;
    font-size: 27px;
    font-weight: 500;
    min-width: 46px;
    min-height: 42px;
    padding: 2px 9px 5px 9px;
}
#hamburgerButton:hover { background:#fff3f4; border-color:#e30613; color:#d90416; }
#hamburgerButton:pressed { background:#ffe5e8; }
#hamburgerButton::menu-indicator { image:none; width:0px; }
QMenu {
    background: #ffffff;
    border: 1px solid #d8e0e8;
    border-radius: 9px;
    padding: 7px;
}
QMenu::item { padding: 10px 42px 10px 16px; border-radius: 6px; }
QMenu::item:selected { background:#fff0f2; color:#d90416; }
QMenu::separator { height:1px; background:#e6ebf0; margin:5px 8px; }
#dashboardPanel { background:#ffffff; border:1px solid #dfe6ed; border-radius:11px; }
#dashboardHero { background:#082745; border:none; border-radius:10px; }
#heroEyebrow { color:#8ed3f4; font-size:12px; font-weight:700; letter-spacing:1px; }
#heroGreeting { color:#ffffff; font-size:29px; font-weight:700; }
#heroSubtitle { color:#f0f5fb; font-size:14px; }
#heroDate {
    color:#ffffff;
    background:rgba(35, 84, 121, 185);
    border:1px solid rgba(215, 233, 246, 130);
    border-radius:8px;
    padding:10px 14px;
    font-size:13px;
    font-weight:600;
}
#quickActionCard { background:#ffffff; border:1px solid #dfe6ed; border-radius:10px; }
#quickActionIcon { background:#f1f5f9; border-radius:10px; }
#quickActionTitle { color:#15243a; font-size:18px; font-weight:700; }
#quickPrimary, #quickSecondary {
    border-radius:7px;
    padding:9px 16px;
    font-size:13px;
    font-weight:700;
}
#quickPrimary { color:#ffffff; background:#e30613; border:1px solid #e30613; }
#quickPrimary:hover { background:#c90011; }
#quickSecondary { color:#e30613; background:#ffffff; border:1px solid #e30613; }
#quickSecondary:hover { background:#fff3f4; }
#dashboardTitle { font-size:17px; font-weight:700; color:#172740; }
#dashboardSubtitle, #dashboardUpdated { color:#647792; font-size:13px; }
#dashboardMetric { background:transparent; }
#dashboardMetric:hover { background:#fbfcfe; }
#metricDivider { color:#dfe6ed; margin:4px 0px; }
#metricTitle { color:#536984; font-size:13px; font-weight:600; }
#metricValue { color:#0d1c33; font-size:28px; font-weight:700; }
#metricPercent { color:#61738b; font-size:12px; font-weight:600; }
#dashboardRefresh, #historyLink {
    background:#ffffff;
    color:#174cbd;
    border:1px solid #d8e1ec;
    border-radius:8px;
    padding:9px 14px;
    font-size:13px;
    font-weight:600;
}
#dashboardRefresh:hover, #historyLink:hover { background:#f3f7ff; border-color:#8da9df; }
#recentResultsTable { border:1px solid #e3e9f0; border-radius:7px; }
#recentResultsTable::item { padding:7px; }
#section { background:#ffffff; border:1px solid #e6ebf0; border-radius:10px; }
#sectionMarker { background:#e30613; border-radius:2px; }
#sectionTitle { font-size:17px; font-weight:700; }
#pageTitle { font-size:27px; font-weight:700; }
#actionCard { background:#ffffff; border:1px solid #e1e7ed; border-radius:9px; }
#actionIcon { background:#fff0f1; border-radius:12px; }
#actionTitle { font-size:20px; font-weight:700; }
#primaryButton { background:#e30613; color:white; border:1px solid #e30613; border-radius:7px; padding:11px 22px; font-weight:600; min-height:20px; }
#primaryButton:hover { background:#c90011; }
#primaryButton:pressed { background:#ac0010; }
#primaryButton:disabled { background:#e5e9ee; color:#7c8999; border-color:#d7dde4; }
#secondaryButton { background:#ffffff; color:#d90416; border:1px solid #e30613; border-radius:7px; padding:11px 22px; font-weight:600; min-height:20px; }
#secondaryButton:hover { background:#fff3f4; }
#smallButton, #iconButton { background:#ffffff; border:1px solid #d8e0e8; border-radius:7px; padding:8px 14px; }
#iconButton { padding:8px; }
#summaryCard { background:#ffffff; border:1px solid #dfe6ed; border-radius:8px; text-align:left; }
#summaryCard:hover { border-color:#e30613; background:#fffafb; }
#summaryValue { font-size:27px; font-weight:700; }
#summaryTitle { font-size:15px; }
#cardArrow { font-size:28px; color:#334a62; }
#centerMessage { font-size:18px; padding:24px; }
#progressOrder { font-size:24px; font-weight:700; padding-top:20px; }
#completionSummary { background:#f6f9fc; border:1px solid #dfe6ed; border-radius:8px; padding:14px; font-weight:600; }
#errorText { color:#b00013; padding:4px; }
QLineEdit, QSpinBox, QComboBox { background:white; border:1px solid #cfd8e2; border-radius:6px; padding:9px; min-height:20px; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border:2px solid #d90416; }
#quantityControl { background:white; border:1px solid #cfd8e2; border-radius:7px; }
#quantityControl:focus-within { border:2px solid #d90416; }
#quantitySpin { background:transparent; border:none; padding:6px 8px; font-size:16px; font-weight:600; }
#quantitySpin:focus { border:none; }
#quantityStep {
    background:#f7f9fb;
    border:none;
    border-left:1px solid #cfd8e2;
    width:30px;
    height:23px;
    padding:2px;
}
#quantityStep:hover { background:#ffecee; }
#quantityStep:pressed { background:#ffdadd; }
QTableWidget { background:white; alternate-background-color:#f8fafc; border:1px solid #e1e7ed; border-radius:6px; gridline-color:#e8edf2; selection-background-color:#ffe8ea; selection-color:#0c1930; }
QHeaderView::section { background:#f2f5f8; border:none; border-bottom:1px solid #dfe6ed; padding:9px; color:#40536c; font-weight:600; }
QProgressBar { background:#edf1f5; border:none; border-radius:7px; height:14px; text-align:center; }
QProgressBar::chunk { background:#e30613; border-radius:7px; }
#searchActivity { background:#f3dadd; border-radius:4px; }
#searchActivity::chunk { background:#e30613; border-radius:4px; }
QScrollArea { border:none; background:transparent; }

QFrame#loginCard {
    background: white;
    border: 1px solid #d8e0ea;
    border-radius: 12px;
}
QLabel#loginError {
    color: #c8102e;
    background: #fff1f3;
    border: 1px solid #ffc9d2;
    border-radius: 6px;
    padding: 8px;
}
