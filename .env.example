# Public/non-secret target configuration. Override only when using another sheet.
DMS_SMARTSHEET_SHEET_ID=w9PHJHJXQCppp3xfXWQcGxhqXP43MJXcfJFp3q41

# Do not place the Smartsheet API token in this file or source control.
